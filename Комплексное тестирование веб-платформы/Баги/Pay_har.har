t.paymentmethod == 135\t\t\t\t\t|| result.paymentmethod == 136\t\t\t\t\t|| result.paymentmethod == 42\t\t\t\t\t|| result.paymentmethod == 35\t\t\t\t\t|| result.paymentmethod == 67\t\t\t\t\t|| result.paymentmethod == 68\t\t\t\t\t|| result.paymentmethod == 69\t\t\t\t\t|| result.paymentmethod == 70\t\t\t\t\t|| result.paymentmethod == 71\t\t\t\t\t|| result.paymentmethod == 72\t\t\t\t\t|| result.paymentmethod == 73\t\t\t\t\t|| result.paymentmethod == 74\t\t\t\t\t|| result.paymentmethod == 75\t\t\t\t\t|| result.paymentmethod == 76\t\t\t\t\t|| result.paymentmethod == 77\t\t\t\t\t|| result.paymentmethod == 79\t\t\t\t\t|| result.paymentmethod == 81\t\t\t\t\t|| result.paymentmethod == 82\t\t\t\t\t|| result.paymentmethod == 83\t\t\t\t\t|| result.paymentmethod == 84\t\t\t\t\t|| result.paymentmethod == 85\t\t\t\t\t|| result.paymentmethod == 86\t\t\t\t\t|| result.paymentmethod == 87\t\t\t\t\t|| result.paymentmethod == 88\t\t\t\t\t|| result.paymentmethod == 89\t\t\t\t\t|| result.paymentmethod == 90\t\t\t\t\t|| result.paymentmethod == 91\t\t\t\t\t|| result.paymentmethod == 92\t\t\t\t\t|| result.paymentmethod == 93\t\t\t\t\t|| result.paymentmethod == 94\t\t\t\t\t|| result.paymentmethod == 95\t\t\t\t\t|| result.paymentmethod == 96\t\t\t\t\t|| result.paymentmethod == 97\t\t\t\t\t|| result.paymentmethod == 98\t\t\t\t\t|| result.paymentmethod == 99\t\t\t\t\t|| result.paymentmethod == 100\t\t\t\t\t|| result.paymentmethod == 101\t\t\t\t\t|| result.paymentmethod == 102\t\t\t\t\t|| result.paymentmethod == 103\t\t\t\t\t|| result.paymentmethod == 104\t\t\t\t\t|| result.paymentmethod == 105\t\t\t\t\t|| result.paymentmethod == 106\t\t\t\t\t|| result.paymentmethod == 107\t\t\t\t\t|| result.paymentmethod == 108\t\t\t\t\t|| result.paymentmethod == 109\t\t\t\t\t|| result.paymentmethod == 110\t\t\t\t\t|| result.paymentmethod == 111\t\t\t\t\t|| result.paymentmethod == 112\t\t\t\t\t|| result.paymentmethod == 113\t\t\t\t\t|| result.paymentmethod == 114\t\t\t\t\t|| result.paymentmethod == 115\t\t\t\t\t|| result.paymentmethod == 119\t\t\t\t\t|| result.paymentmethod == 120\t\t\t\t\t|| result.paymentmethod == 116\t\t\t\t\t|| result.paymentmethod == 117\t\t\t\t\t|| result.paymentmethod == 118\t\t\t\t\t|| result.paymentmethod == 63\t\t\t\t\t|| result.paymentmethod == 137\t\t\t\t\t|| result.paymentmethod == 138\t\t\t\t\t|| result.paymentmethod == 139\t\t\t\t\t|| result.paymentmethod == 140\t\t\t\t\t|| result.paymentmethod == 141\t\t\t\t\t|| result.paymentmethod == 142\t\t\t\t\t|| result.paymentmethod == 143\t\t\t\t\t|| result.paymentmethod == 144\t\t\t\t\t|| result.paymentmethod == 145\t\t\t\t\t|| result.paymentmethod == 146\t\t\t\t\t|| result.paymentmethod == 147\t\t\t\t\t|| result.paymentmethod == 148\t\t\t\t\t|| result.paymentmethod == 149\t\t\t\t\t|| result.paymentmethod == 150\t\t\t\t\t|| result.paymentmethod == 151\t\t\t\t\t|| result.paymentmethod == 152\t\t\t\t\t|| result.paymentmethod == 153\t\t\t\t\t|| result.paymentmethod == 154\t\t\t\t\t|| result.paymentmethod == 155\t\t\t\t\t|| result.paymentmethod == 156\t\t\t\t\t|| result.paymentmethod == 157\t\t\t\t\t|| result.paymentmethod == 158\t\t\t\t\t|| result.paymentmethod == 159\t\t\t\t\t|| result.paymentmethod == 160\t\t\t\t\t|| result.paymentmethod == 161\t\t\t\t\t|| result.paymentmethod == 162\t\t\t\t\t|| result.paymentmethod == 163\t\t\t\t\t|| result.paymentmethod == 164\t\t\t\t\t|| result.paymentmethod == 122\t\t\t\t)\n\t\t{\n\t\t\t\n\t\t\t\t\t\t$('is_external_finalize_transaction').value = 1;\n\n\n\t\t\tGetFinalPriceAndUpdateReviewTab();\n\t\t}\n\t\telse if ( result.paymentmethod == 128 )\n\t\t{\n\t\t\t\t\t\tDHighlightItemByValue( 'payment_method', 'steamaccount', true );\n\t\t\tGetFinalPriceAndUpdateReviewTab();\n\t\t}\n\t\telse\n\t\t{\n\t\t\t\t\t\tGetFinalPriceAndUpdateReviewTab();\n\t\t}\n\t}\n\tcatch( e )\n\t{\n\t\tReportCheckoutJSError( 'Failed handling InitializeTransaction success', e );\n\t}\n}\n\nfunction OnInitializeTransactionFailure( detail, result )\n{\n\ttry\n\t{\n\t\t\t\tSetTabEnabled( 'payment_info' );\n\t\tvar error_text = 'Произошла ошибка при инициализации или обновлении перевода. Подождите несколько минут и повторите попытку, либо обратитесь в службу поддержки.';\n\t\tif ( result && result.specificerrortext )\n\t\t{\n\t\t\terror_text = result.specificerrortext;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tswitch ( detail )\n\t\t\t{\n\t\t\t\tcase 1:\n\t\t\t\t\terror_text = 'В реквизитах указан неверный адрес. Исправьте ошибку или обратитесь в службу поддержки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 2:\n\t\t\t\t\terror_text = 'На счете недостаточно средств. Исправьте ошибку или обратитесь в службу поддержки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 3:\n\t\t\t\t\terror_text = 'Произошла внутренняя ошибка при попытке перевода средств. Обратитесь в службу поддержки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 6:\n\t\t\t\t\terror_text = 'Не удалось использовать выбранный способ оплаты при покупке. Пожалуйста, выберите другой способ и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 82:\n\t\t\t\t\terror_text = 'В настоящее время этот способ оплаты невозможно использовать. Мы устраняем данную проблему. Пожалуйста, выберите другой способ оплаты и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 83:\n\t\t\t\t\terror_text = 'Выбранный способ оплаты не поддерживается для продукта, который вы желаете приобрести. Пожалуйста, выберите другой способ и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 33:\n\t\t\t\t\terror_text = 'Покупка не завершена, так как истёк срок действия вашей банковской карты. Пожалуйста, введите информацию другой карты и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 24:\n\t\t\t\t\terror_text = 'Операция не выполнена, потому что у вас нет игры, необходимой для использования дополнения, которое вы пытаетесь приобрести. Исправьте ошибку и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 9:\n\t\t\t\t\terror_text = 'Покупка не может быть завершена, потому что у вас уже есть одна из игр, которую вы пытаетесь купить. Проверьте аккаунт и корзину, чтобы убедиться в том, что вы не покупаете товар, которым уже владеете.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 57:\n\t\t\t\t\terror_text = 'Покупка не может быть завершена, потому что у вас уже имеется подписка на этот товар. Вы можете управлять своими подписками со страницы своего <a href=\\'https://store.steampowered.com/account\\'>аккаунта</a>.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 31:\n\t\t\t\t\terror_text = 'Покупка не может быть завершена, потому что валюта денежных средств в вашем кошельке Steam не соответствует валюте, используемой для данной покупки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 35:\n\t\t\t\t\terror_text = 'Покупка не завершена.<br>Добавление желаемой суммы превысит лимит кошелька Steam.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 39:\n\t\t\t\t\terror_text = 'Ваша покупка не может быть завершена, т.к. ваша корзина содержит товары, которые нельзя подарить.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 40:\n\t\t\t\t\terror_text = 'Покупка не может быть завершена, т.к. в корзине содержатся товары, недоступные за пределами США.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 38:\n\t\t\t\t\terror_text = 'Ваш заказ не может быть завершен, так как одного или нескольких товаров, находящихся в вашей корзине, нет в наличии. Повторите попытку позже.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 59:\n\t\t\t\t\terror_text = 'Ваш заказ не может быть завершен, т.к. один или несколько товаров в корзине нельзя отправить на ваш адрес доставки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 44:\n\t\t\t\t\terror_text = 'Покупка не была завершена. На вашем аккаунте отключена возможность покупки. За более подробной информацией обращайтесь в службу поддержки Steam.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 45:\n\t\t\t\t\terror_text = 'Внимание!<br><br>Ваша последняя покупка не была завершена. Платежный оператор еще не подтвердил снятие средств с вашего счета.<br><br>Прежде чем продолжать покупку, свяжитесь со своим платежным оператором и убедитесь, что эта покупка не была завершена. При продолжении покупки, средства с вашего счета могут быть сняты дважды.';\n\t\t\t\t\t$J('#cancel_pending_verification').show();\n\t\t\t\t\tValidationMarkFieldBad( $('cancel_pending_label' ) );\n\t\t\t\t\tbreak;\n\t\t\t\tcase 46:\n\t\t\t\t\terror_text = 'С целью защиты владельца аккаунта эта покупка была заблокирована, а также были временно ограничены дальнейшие покупки. Пожалуйста, свяжитесь с поддержкой Steam, чтобы разрешить эту проблему.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 47:\n\t\t\t\t\terror_text = 'Операция не может быть завершена, поскольку вы пытаетесь приобрести игру, которая уже включена в один из комплектов в вашей корзине. Пожалуйста, проверьте содержимое вашей корзины и убедитесь, что вы не покупаете одну и ту же игру несколько раз. Чаще всего так происходит, когда вы добавляете в корзину дополнительный контент и делюкс-издание игры, которое уже включает этот контент.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 23:\n\t\t\t\t\terror_text = 'Выбранный способ оплаты не соответствует стране магазина. Цены на товар в вашей корзине были преобразованы. Обновленная общая сумма будет показана на следующей странице. Вы можете просмотреть свою корзину, нажав <a href=\\'https://store.steampowered.com/cart/country_changed\\'>здесь</a>, или изменить способ оплаты, перейдя ниже.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 8:\n\t\t\t\t\terror_text = 'Операция не может быть завершена, так как на вашем аккаунте присутствует другая незавершенная операция.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 52:\n\t\t\t\t\terror_text = 'Операция не может быть завершена, так как на вашем аккаунте присутствует другая незавершенная операция, включающая один или несколько товаров из вашей корзины.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 55:\n\t\t\t\t\terror_text = 'Номер этой карты не соответствует выбранному вами методу оплаты.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 56:\n\t\t\t\t\terror_text = 'Эй, транжира, полегче! Общая цена предметов в вашей корзине превышает допустимый предел на сумму покупки. Пожалуйста, <a href=\\'https://store.steampowered.com/cart\\'>измените содержимое корзины</a> и повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 53:\n\t\t\t\t\terror_text = 'За последние несколько часов вы пытались совершить слишком много покупок. Пожалуйста, подождите немного.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 13:\n\t\t\t\t\terror_text = 'Ваша покупка не может быть завершена, так как в вашей корзине находятся товары, недоступные в вашей стране.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 70:\n\t\t\t\t\terror_text = 'У получателя уже есть этот продукт.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 71:\n\t\t\t\t\terror_text = 'Подарок, который вы хотите приобрести, недоступен в регионе получателя.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 72:\n\t\t\t\t\terror_text = 'Подарок невозможно отправить, так как цена в регионе получателя значительно отличается от вашей цены.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 69:\n\t\t\t\t\terror_text = 'Заказ невозможно выполнить, так как в корзине находятся товары, предназначенные только для коммерческого использования.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 74:\n\t\t\t\t\terror_text = 'Заказ невозможно выполнить, так как в корзине находятся товары, которые нельзя использовать на коммерческих аккаунтах.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 75:\n\t\t\t\t\terror_text = 'Ваша текущая страна не совпадает с той, где зарегистрирована ваша фирма.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 78:\n\t\t\t\t\terror_text = 'Расчётный адрес слишком длинный. Укажите краткую версию адреса или разделите его на два поля.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 79:\n\t\t\t\t\terror_text = 'Судя по всему, вы указали недействительный номер банковской карты. Перепроверьте информацию и попробуйте ещё раз.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 81:\n\t\t\t\t\terror_text = 'В реквизитах не указано имя, или оно содержит слишком много цифр.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 87:\n\t\t\t\t\terror_text = 'Покупку нельзя совершить: в вашей корзине есть товары, которые вы купили ранее, но удалили с аккаунта. Чтобы вернуть доступ к контенту, обратитесь в <a href=\"https://help.steampowered.com/ru/wizard/HelpWithGame\">службу поддержки</a>.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 84:\n\t\t\t\t\terror_text = 'Покупка не может быть совершена, поскольку один из продуктов в вашей корзине сейчас недоступен и вам нужно присоединиться к списку ожидания.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 96:\n\t\t\t\t\terror_text = 'Менять страну аккаунта Steam можно не чаще, чем раз в три месяца. Завершите покупку, используя способ оплаты из текущего региона.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 97:\n\t\t\t\t\terror_text = 'Для коммерческих покупок из вашего региона требуется номер плательщика НДС. Пожалуйста, войдите в свой аккаунт на партнёрском сайте Steamworks и добавьте номер плательщика НДС в информацию о вашей компании.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 98:\n\t\t\t\t\terror_text = 'Операция не выполнена: не удалось подтвердить адрес доставки.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 99:\n\t\t\t\t\terror_text = 'Заказ невозможно выполнить, так как для покупки этого товара больше не требуется плата за бронирование.';\n\t\t\t\t\tbreak;\n\t\t\t\tcase 100:\n\t\t\t\t\terror_text = 'Покупка не может быть совершена, поскольку в вашей корзине есть продукты, которые невозможно приобрести. <a href=\"https://store.steampowered.com/cart\">Проверьте содержимое своей корзины</a>, а затем повторите попытку.';\n\t\t\t\t\tbreak;\n\t\t\t\tdefault:\n\t\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\n\t\tDisplayErrorMessage( error_text );\n\t}\n\tcatch (e)\n\t{\n\t\tReportCheckoutJSError( 'Failed handling InitializeTransaction failure', e );\n\t}\n}\n\n\nfunction OnAuthenticationComplete( gidTransID )\n{\n\t\tif ( gidTransID && g_LastFinalizedTransactionID != gidTransID )\n\t\treturn;\n\n\tif ( g_timeoutPoll )\n\t{\n\t\tclearTimeout( g_timeoutPoll );\n\t}\n\n\tg_timeoutPoll = setTimeout( NewPollForTransactionStatusClosure( g_LastFinalizedTransactionID, 120, 15 ), 1*1000 );\n\n\t$J('#authentication_button_bottom').hide();\n\t$J('#authentication_button_inprogress_bottom').show();\n\n\treturn true;\n}\n\nfunction OnAuthenticationFail()\n{\n\tif ( g_timeoutPoll )\n\t{\n\t\tclearTimeout( g_timeoutPoll );\n\t}\n\n\t// Show a generic error\n\tHandleFinalizeTransactionFailure( 2, 7, false, '' );\n\treturn true;\n}\n\n\nfunction OnPayPalSuccess( gidTransID )\n{\n\t\tif ( gidTransID && $('transaction_id').value != gidTransID )\n\t\treturn;\n\n\t$J('#submit_payment_info_btn').show();\n\t$J('#paypal-button').hide();\n\n\t\tif ( $('is_external_finalize_transaction').value == 1 )\n\t{\n\t\t\t\tif ( g_bPollingForTransactionStatus )\n\t\t{\n\t\t\tif ( g_timeoutPoll )\n\t\t\t{\n\t\t\t\tclearTimeout( g_timeoutPoll );\n\n\t\t\t\tvar method = $('payment_method');\n\n\t\t\t\tswitch( method.value )\n\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tcase 'boleto':\n\t\t\t\t\tcase 'boacompragold':\n\t\t\t\t\tcase 'bancodobrasilonline':\n\t\t\t\t\tcase 'itauonline':\n\t\t\t\t\tcase 'bradescoonline':\n\t\t\t\t\tcase 'pagseguro':\n\t\t\t\t\tcase 'visabrazil':\n\t\t\t\t\tcase 'amexbrazil':\n\t\t\t\t\tcase 'hipercard':\n\t\t\t\t\tcase 'aura':\n\t\t\t\t\tcase 'mastercardbrazil':\n\t\t\t\t\tcase 'dinerscardbrazil':\n\t\t\t\t\tcase 'multibanco':\n\t\t\t\t\tcase 'payshop':\n\t\t\t\t\tcase 'maestroboacompra':\n\t\t\t\t\tcase 'visaelectronboacompra':\n\t\t\t\t\tcase 'oxxo':\n\t\t\t\t\tcase 'toditocash':\n\t\t\t\t\tcase 'carnet':\n\t\t\t\t\tcase 'spei':\n\t\t\t\t\tcase '3pay':\n\t\t\t\t\tcase 'isbank':\n\t\t\t\t\tcase 'garanti':\n\t\t\t\t\tcase 'akbank':\n\t\t\t\t\tcase 'yapikredi':\n\t\t\t\t\tcase 'halkbank':\n\t\t\t\t\tcase 'bankasya':\n\t\t\t\t\tcase 'finansbank':\n\t\t\t\t\tcase 'denizbank':\n\t\t\t\t\tcase 'ptt':\n\t\t\t\t\tcase 'cashu':\n\t\t\t\t\tcase 'onecard':\n\t\t\t\t\tcase 'molpoints':\n\t\t\t\t\tcase 'konbini':\n\t\t\t\t\tcase 'bank_transfer_japan':\n\t\t\t\t\tcase 'payeasy':\n\t\t\t\t\tcase 'pse':\n\t\t\t\t\tcase 'exito':\n\t\t\t\t\tcase 'efecty':\n\t\t\t\t\tcase 'baloto':\n\t\t\t\t\tcase 'pinvalidda':\n\t\t\t\t\tcase 'mangirkart':\n\t\t\t\t\tcase 'bancocreditodeperu':\n\t\t\t\t\tcase 'bbvacontinental':\n\t\t\t\t\tcase 'safetypay':\n\t\t\t\t\tcase 'pagoefectivo':\n\t\t\t\t\tcase 'nodwin_cod':\n\t\t\t\t\tcase 'boletoflash':\n\t\t\t\t\t\tDisplayPendingReceiptPage();\n\t\t\t\t\t\tbreak;\n\n\t\t\t\t\tdefault:\n\t\t\t\t\t\t\t\t\t\t\t\tg_timeoutPoll = setTimeout( NewPollForTransactionStatusClosure( $('transaction_id').value, 120, 15 ), 1*1000 );\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tFinalizeTransaction();\n\t\t}\n\t}\n\telse\n\t{\n\t\tif ( g_bPayPalAuthInFlight )\n\t\t\tGetFinalPriceAndUpdateReviewTab();\n\t\tg_bPayPalAuthInFlight = false;\n\t}\n\treturn true;\n}\n\n\nfunction OnPayPalCancel( gidTransID )\n{\n\t\tif ( gidTransID && $('transaction_id').value != gidTransID )\n\t\treturn;\n\n\t$J('#payment_method_previous_button').show();\n\t$J('#paypal-button').hide();\n\n\tHandleFinalizeTransactionFailure( 4, 0, false, '' );\n\treturn true;\n}\n\nvar g_bGetFinalPriceRunning = false;\nfunction GetFinalPriceAndUpdateReviewTab()\n{\n\ttry\n\t{\n\t\t\t\tif ( g_bGetFinalPriceRunning )\n\t\t\treturn;\n\n\t\tg_bGetFinalPriceRunning = true;\n\t\t// clear the cancel pending checkbox in case we need to go back\n\t\t$('cancel_pending').checked = false;\n\n\t\t\t\t\t\tif ( !g_bAnimatingSubmitButtonCurrently )\n\t\t\tAnimateSubmitPaymentInfoButton();\n\n\t\t\t\tvar transid = $('transaction_id').value;\n\t\tvar microtxnid = $('microtxn_id') ? $('microtxn_id').value : -1;\n\t\tvar cart = $J('#shopping_cart_gid' ).val() || -1;\n\t\tvar gidReplayOfTransID = $J('#gid_replay' ).val() || -1;\n\t\tnew Ajax.Request('https://checkout.steampowered.com/checkout/getfinalprice/',\n\t\t{\n\t\t    method:'get',\n\t\t    parameters: {\n\t\t\t\t'count' : ++nGetFinalPriceCalls,\n\t\t\t\t'transid' : transid,\n\t\t\t\t'purchasetype' : g_bIsGiftForm || g_bIsPurchaseRequest ? 'gift' : 'self',\n\t\t\t\t'microtxnid' : microtxnid,\n\t\t\t\t'cart' : cart,\n\t\t\t\t'gidReplayOfTransID' : gidReplayOfTransID\n\t\t\t},\n\t\t    onSuccess: function(transport){\n\t\t    \tg_bGetFinalPriceRunning = false;\n\t\t\t\tif ( transport.responseText ){\n\t\t\t\t\ttry {\n\t\t\t\t\t\tvar result = transport.responseText.evalJSON(true);\n\t\t      \t\t} catch ( e ) {\n\t\t      \t\t\tOnGetFinalPriceFailure( 0 );\n\t\t      \t\t}\n\t\t      \t   \tif ( result.success == 1 )\n\t\t      \t   \t{\n\t\t      \t   \t\tOnGetFinalPriceSuccess( result );\n\t\t      \t   \t\treturn;\n\t\t      \t   \t}\n\t\t      \t   \telse\n\t\t      \t   \t{\n\t\t      \t   \t\tOnGetFinalPriceFailure( result.purchaseresultdetail );\n\t\t      \t   \t\treturn;\n\t\t      \t   \t}\n\t\t\t  \t}\n\n\t\t\t\t\t\t\t\tOnGetFinalPriceFailure( 0 );\n\t\t    },\n\t\t    onFailure: function(){\n\t\t\t\t\t\t\t\tg_bGetFinalPriceRunning = false;\n\t\t\t\tOnGetFinalPriceFailure( 0 );\n\t\t\t}\n\t\t});\n\t}\n\tcatch(e)\n\t{\n\t\tReportCheckoutJSError( 'Failed making GetFinalPrice request', e );\n\t}\n}\n\nvar g_bRequiresCVVReEntry = false;\nfunction OnGetFinalPriceSuccess( result )\n{\n\ttry\n\t{\n\t\t\t\t$('stored_card_processing').hide();\n\t\tg_bRequiresCVVReEntry = result.requirecvv;\n\n\t\t\t\tUpdateReviewPageBillingInfoWithCurrentValues( result );\n\n\t\tif ( result )\n\t\t{\n\t\t\t\t\t\tif ( result.total )\n\t\t\t\tg_nPurchaseTotal = result.total;\n\n\t\t\tif ( result.steamAccountBalance )\n\t\t\t\tg_nSteamAccountBalance = result.steamAccountBalance;\n\n\t\t\tif ( result.formattedProviderRemaining )\n\t\t\t\tg_strProviderRemaining = result.formattedProviderRemaining;\n\n\t\t\t\t\t\tif ( result.providerpaymentmethod != null && result.total && result.steamAccountBalance )\n\t\t\t{\n\t\t\t\tif ( result.providerpaymentmethod == 0 && result.total > result.steamAccountBalance )\n\t\t\t\t{\n\t\t\t\t\tSetTabEnabled( 'payment_info' );\n\t\t\t\t\t\t\t\t\t\tg_bUseRemainingSteamAccount = true;\n\t\t\t\t\tShowNextPaymentMethod();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tresult.priceOfASubChanged ? $J('#checkout_review_cart_message').show() : $('checkout_review_cart_message').hide();\n\t\t}\n\n\t\tvar method = $('payment_method');\n\n\t\t\t\tif ( $('is_external_finalize_transaction').value == 1 )\n\t\t{\n\t\t\tif ( $('col_right_review_payment_tips') )\n\t\t\t{\n\t\t\t\t$J('#col_right_review_payment_tips').show();\n\t\t\t}\n\n\t\t\tif ( result.externalurl )\n\t\t\t{\n\t\t\t\t\t\t\t\tvar url = result.externalurl.replace( /%/g, '%25' );\n\t\t\t\t$('purchase_button_bottom').href = \"javascript:PerformExternalFinalizeTransaction( '\"+url.replace( /\\'/g, \"\\\\'\" )+\"', \" + ( result.useexternalredirect ? \"true\" : \"false\" ) + \" );\";\n\t\t\t\t$J('#purchase_bottom_note_paypalgc').show();\n\n\t\t\t\t$('purchase_top').show();\n\n\t\t\t\tif ( method.value == 'giropay' )\n\t\t\t\t{\n\t\t\t\t\t$('purchase_bottom_note_paypalgc').innerHTML = 'Операции с GiroPay производятся через сайт вашего банка. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.';\n\t\t\t\t\t$('purchase_button_bottom_text').innerHTML = 'Продолжить авторизацию в GiroPay';\n\n\t\t\t\t\tif ( $('col_right_review_payment_tips_header_text') && $('col_right_review_payment_tips_info_text') )\n\t\t\t\t\t{\n\t\t\t\t\t\t$('col_right_review_payment_tips_header_text').innerHTML = 'Советы для пользователей GiroPay';\n\t\t\t\t\t\t$('col_right_review_payment_tips_info_text').innerHTML = 'При совершении покупки через Giropay вы будете перенаправлены на сайт банка, где вам потребуется ввести банковский сетевой ПИН-код и уникальный TAN-код. Если в данный момент у вас нет ПИН- или TAN-кода, пожалуйста, выберите другой способ оплаты. Если через 10 секунд вы не вернулись в Steam, пожалуйста, нажмите кнопку «Return To Merchant» для того, чтобы сделать это.<br/><br/>Этот процесс может длиться до 60 секунд. Для того, чтобы исключить возможность неудачного проведения покупки, пожалуйста, не нажимайте кнопку «Назад» и не закрывайте окно с GiroPay.';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if ( method.value == 'ideal' )\n\t\t\t\t{\n\t\t\t\t\t$('purchase_bottom_note_paypalgc').innerHTML = 'Операции с iDEAL производятся через сайт iDEAL. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.';\n\t\t\t\t\t$('purchase_button_bottom_text').innerHTML = 'Перейти на сайт авторизации iDEAL';\n\t\t\t\t\tif ( $('col_right_review_payment_tips_header_text') && $('col_right_review_payment_tips_info_text') )\n\t\t\t\t\t{\n\t\t\t\t\t\t$('col_right_review_payment_tips_header_text').innerHTML = 'Советы для пользователей iDEAL';\n\t\t\t\t\t\t$('col_right_review_payment_tips_info_text').innerHTML = 'Не забудьте подтвердить вашу покупку на сайте iDEAL. Если в течение 10 секунд вы не будете возвращены в Steam автоматически — пожалуйста, нажмите на кнопку «Back to Shop» и дождитесь окончания обработки текущей транзакции.<br/><br/>Этот процесс может занимать до 60 секунд. Во избежание ошибок, связанных с покупкой товара, пожалуйста, не нажимайте кнопку перехода на предыдущую страницу и не закрывайте окно iDEAL до завершения процесса.';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if ( method.value == 'paysafe' )\n\t\t\t\t{\n\t\t\t\t\t$('purchase_bottom_note_paypalgc').innerHTML = 'Операции с paysafecard производятся через сайт paysafe. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.';\n\t\t\t\t\t$('purchase_button_bottom_text').innerHTML = 'Перейти на сайт авторизации paysafecard';\n\t\t\t\t\tif ( $('col_right_review_payment_tips_header_text') && $('col_right_review_payment_tips_info_text') )\n\t\t\t\t\t{\n\t\t\t\t\t\t$('col_right_review_payment_tips_header_text').innerHTML = 'Советы для пользователей paysafecard';\n\t\t\t\t\t\t$('col_right_review_payment_tips_info_text').innerHTML = 'Не забудьте подтвердить вашу покупку на сайте paysafecard. После того, как вы введете свой код, вы будете автоматически перенаправлены назад в клиент Steam для подтверждения вашей покупки. Во избежание ошибок, связанных с покупкой товара, пожалуйста, не нажимайте кнопку перехода на предыдущую страницу и не закрывайте окно paysafe до завершения процесса.';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if ( method.value == 'paypal' || method.value == 'storedpaypal' || method.value == 'updatepaypal' )\n\t\t\t\t{\n\t\t\t\t\t$('purchase_bottom_note_paypalgc').innerHTML = 'Операции с PayPal производятся через сайт PayPal. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.';\n\t\t\t\t\t$('purchase_button_bottom_text').innerHTML = 'Начать покупку PayPal';\n\n\t\t\t\t\tif ( $('col_right_review_payment_tips_header_text') && $('col_right_review_payment_tips_info_text') )\n\t\t\t\t\t{\n\t\t\t\t\t\t$('col_right_review_payment_tips_header_text').innerHTML = 'Советы для пользователей PayPal';\n\t\t\t\t\t\t$('col_right_review_payment_tips_info_text').innerHTML = 'Убедитесь, что вы подтвердили покупку на сайте PayPal. Если через 10 секунд вы не вернулись в Steam, пожалуйста, нажмите кнопку «Return To Merchant» для того, чтобы сделать это.<br/><br/>Этот процесс может длиться до 60 секунд. Для того, чтобы исключить возможность неудачного проведения покупки, пожалуйста, не нажимайте кнопку «назад» и не закрывайте окно с PayPal.';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\telse if ( method.value == 'sofort' )\n\t\t\t\t{\n\t\t\t\t\t$('purchase_bottom_note_paypalgc').innerHTML = 'Операции с Klarna производятся через сайт Klarna. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.';\n\t\t\t\t\t$('purchase_button_bottom_text').innerHTML = 'Перейти на сайт Klarna';\n\t\t\t\t\tif ( $('col_right_review_payment_tips_header_text') && $('col_right_review_payment_tips_info_text') )\n\t\t\t\t\t{\n\t\t\t\t\t\t$('col_right_review_payment_tips_header_text').innerHTML = 'Советы для пользователей Klarna';\n\t\t\t\t\t\t$('col_right_review_payment_tips_info_text').innerHTML = 'Не забудьте подтвердить свою покупку на сайте Klarna. При использовании Klarna в качестве метода оплаты, нажмите на кнопку NEXT после того, как введёте свой TAN или PIN-код. Вы будете автоматически перенаправлены назад в клиент Steam, и увидите подтверждение об оплате.<br/><br/>Этот процесс может з
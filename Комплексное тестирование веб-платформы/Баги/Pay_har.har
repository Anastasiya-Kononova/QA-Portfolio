&quot;:&quot;return DSelectOnCancelButton( event, 'billing_country')&quot;}\" role=\"combobox\" aria-expanded=false aria-controls=\"billing_country_droplist\">Россия</button><div class=\"dropcontainer\" id=\"billing_country_listctn\" ><ul class=\"dropdownhidden\" id=\"billing_country_droplist\" role=\"listbox\" data-panel=\"{&quot;bFocusRingRoot&quot;:true,&quot;onCancelButton&quot;:&quot;DSelectHide( 'billing_country')&quot;,&quot;flow-children&quot;:&quot;column&quot;}\"\"><li ><a role=\"option\" data-panel=\"{&quot;noFocusRing&quot;:true}\"class=\"inactive_selection\" tabindex=\"99999\" href=\"javascript:DSelectNoop();\" onmouseover=\"DHighlightItem( 'billing_country', 0, false );\" id=\"RU\" onclick=\"DHighlightItem( 'billing_country', 0, true );\" >Россия</a></li><li ><a role=\"option\" data-panel=\"{&quot;noFocusRing&quot;:true}\"class=\"inactive_selection\" tabindex=\"99999\" href=\"javascript:DSelectNoop();\" onmouseover=\"DHighlightItem( 'billing_country', 1, false );\" id=\"help\" onclick=\"DHighlightItem( 'billing_country', 1, true );\" >Другая…</a></li></ul>\n\t\t\t</div>\n\t\t</div><script language=\"javascript\">$J( function() { $J('#billing_country_dselect_container').on('keydown', HandleKeyDown ); });</script>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"form_right\">\n\n\t\t\t\t\t\t\t\t<div id=\"payment_row_phone\" class=\"form_row\">\n\t\t\t\t\t\t\t\t\t<label for=\"billing_phone\">Телефон</label>\n\t\t\t\t\t\t\t\t\t<input tabindex=\"211\" type=\"text\" class=\"text\" maxlength=\"20\" name=\"billing_phone\" id=\"billing_phone\" value=\"\" autocomplete=\"tel\">\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style=\"clear: both;\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"form_row\" id=\"mobile_number_row\" style=\"display: none;\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<div class=\"form_left\">\n\t\t\t\t\t\t\t\t<label id=\"mobile_number_label\" for=\"mobile_number\" class=\"highlight_on_error\">Мобильный телефон</label>\n\t\t\t\t\t\t\t\t<input type=\"text\" name=\"mobile_number\" id=\"mobile_number\" tabindex=\"202\" value=\"+7 \">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"form_right\">\n\t\t\t\t\t\t\t\t&nbsp;\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"form_row\" id=\"bank_account_id_row\" style=\"display: none;\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<div class=\"form_left\">\n\t\t\t\t\t\t\t\t<label id=\"bank_account_id_label\" for=\"bank_account_id\" class=\"highlight_on_error\">ID аккаунта</label>\n\t\t\t\t\t\t\t\t<input type=\"text\" name=\"bank_account_id\" id=\"bank_account_id\" tabindex=\"202\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"form_right\">\n\t\t\t\t\t\t\t\t&nbsp;\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"\" id=\"payment_row_stored_paypal_details\" style=\"display: none;\">\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\tЭта операция снимет средства с вашего счета PayPal: <span class=\"payment_method_review_method_label\"></span>\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"form_row\" id=\"payment_row_country_verification\" style=\"display: none;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<div id=\"verify_country_notes\">\n\t\t\t\t\t\t\tЕсли ваша страна проживания не Россия, пожалуйста, <a href=\"javascript:PresentCountryCurrencyChangeDialog();\">выберите свой регион для магазина</a>\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"form_row\" id=\"payment_row_save_my_address\" style=\"display: none;\">\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t<div id=\"save_my_address_input\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t    \t\t\t\t\t\t\t\t\t\t<input class=\"checkout_checkbox\" type=\"checkbox\" tabindex=\"300\" id=\"save_my_address\" name=\"save_my_address\" checked=\"checked\">\n\t\t\t\t\t\t\t\t\t\t<label for=\"save_my_address\">Сохранить платёжную информацию для последующих покупок</label>\n                                        \t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div style=\"clear: left;\"></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"form_row\" id=\"payment_row_eight\" style=\"display:none\">\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p id=\"external_payment_processor_notice\"></p>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"checkout_error\" id=\"cant_use_payment_method_in_overlay\" style=\"display: none;\">Выбранный способ оплаты не может использоваться в игре для пополнения кошелька Steam.<br><br>\nЧтобы завершить покупку любого предмета с помощью выбранного способа оплаты, вам нужно сначала пополнить кошелек Steam через браузер.<br><br>\nВы можете пополнить свой кошелек, открыв в браузере следующую ссылку: <a href=\"http://store.steampowered.com/steamaccount/addfunds\">http://store.steampowered.com/steamaccount/addfunds</a><br><br>\nПосле добавления средств на ваш кошелек Steam вы сможете завершить покупку предмета в игровом магазине, используя баланс кошелька Steam.</div>\n\t\t\t\t\t<br>\n\t\t\t\t\t<p id=\"youll_get_to_review\" >\n\t\t\t\t\t\tВы сможете проверить заказ перед его оплатой.\t\t\t\t\t</p>\n\n\t\t\t\t\t<br clear=\"all\">\n\t\t\t\t\t<div class=\"button_row\">\n\t\t\t\t\t\t<button tabindex=\"300\" type=\"submit\" id=\"submit_payment_info_btn\" class=\"btnv6_green_white_innerfade btn_medium continue\">\n\t\t\t\t\t\t\t<span>Продолжить</span>\n\t\t\t\t\t\t</button>\n\t\t\t\t\t\t<div id=\"payment_method_previous_button\" >\n\t\t\t\t\t\t\t<a href=\"javascript:ShowFirstPaymentStep();\" class=\"btnv6_blue_hoverfade btn_medium\"><span>Назад</span></a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"paypal-button\" style=\"display:none; float: right;\"></div>\n\t\t\t\t\t\t<div id=\"submit_payment_info_btn_in_progress\" class=\"btnv6_blue_hoverfade btn_medium btn_disabled working\" style=\"display:none\">\n\t\t\t\t\t\t\t<span>Выполнение</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<br><br><br>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t</form>\n\n\t\t<form method=\"post\" accept-charset=\"utf-8\" name=\"shipping_info_form\" id=\"shipping_info_form\" action=\"\" onsubmit=\"SubmitShippingInfoForm(); return false;\">\n\t\t\t\n\t<div id=\"shipping_info_tab\" class=\"checkout_tab\" style=\"display: none;\">\n\t\t<div class=\"checkout_content\">\n\t\t\t<div id=\"shipping_info_entry\">\n\t\t\t\t<h3 id=\"shipping_header\" class=\"tab_header\">Информация о доставке</h3>\n\t\t\t\t<input type=\"hidden\" maxlength=\"60\" name=\"corrected_shipping_address\" id=\"corrected_shipping_address\" value=\"\">\n\t\t\t\t<input type=\"hidden\" maxlength=\"40\" name=\"corrected_shipping_address_two\" id=\"corrected_shipping_address_two\" value=\"\">\n\t\t\t\t<input type=\"hidden\" maxlength=\"25\" name=\"corrected_shipping_city\" id=\"corrected_shipping_city\" value=\"\">\n\t\t\t\t<input type=\"hidden\" maxlength=\"33\" name=\"corrected_shipping_state\" id=\"corrected_shipping_state\" value=\"\">\n\t\t\t\t<input type=\"hidden\" maxlength=\"10\" name=\"corrected_shipping_postal_code\" id=\"corrected_shipping_postal_code\" value=\"\">\n\n\t\t\t\t<p class=\"shipping_info_pre_note\">\n\t\t\t\t\tВведите адрес для доставки заказа. Если это подарок, вы можете ввести адрес получателя при условии, что проживаете в одной стране.\t\t\t\t</p>\n\n\t\t\t\t<div class=\"form_row\" id=\"shipping_row_one\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<div class=\"form_left\">\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_first_name\" id=\"shipping_first_name_label\">Имя</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"101\" type=\"text\" class=\"text\" maxlength=\"35\" name=\"shipping_first_name\" id=\"shipping_first_name\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_last_name\" id=\"shipping_last_name_label\">Фамилия</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"102\" type=\"text\" class=\"text\" maxlength=\"35\" name=\"shipping_last_name\" id=\"shipping_last_name\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_address\">Адрес доставки</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"103\" type=\"text\" class=\"text\" maxlength=\"35\" name=\"shipping_address\" id=\"shipping_address\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_address_two\">Адрес доставки, строка 2</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"104\" type=\"text\" class=\"text\" maxlength=\"35\" name=\"shipping_address_two\" id=\"shipping_address_two\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_city\">Город</label>\n\t\t\t\t\t\t\t\t<input type=\"text\" class=\"text\" tabindex=\"105\" maxlength=\"25\" name=\"shipping_city\" id=\"shipping_city\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"form_right\">\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_state_text\">Регион</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"106\" type=\"text\" class=\"text\" maxlength=\"33\" name=\"shipping_state_text\" id=\"shipping_state_text\" value=\"\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"dselect_container\" id=\"shipping_state_select_dselect_container\" style=\"display:none\">\n\t\t\t\t\t<input id=\"shipping_state_select\" type=\"hidden\" name=\"shipping_state_select\" value=\"\"/>\n\t\t\t\t\t<button type=\"button\" class=\"trigger\" tabindex=\"106\" id=\"shipping_state_select_trigger\" href=\"javascript:DSelectNoop();\" onfocus=\"DSelectOnFocus( 'shipping_state_select');\" onblur=\"DSelectOnBlur( 'shipping_state_select');\" onclick=\"DSelectOnTriggerClick('shipping_state_select');\" data-panel=\"{&quot;onGamepadDirection&quot;:&quot;return DSelectOnGamepadDirection( event, 'shipping_state_select')&quot;,&quot;onOKButton&quot;:&quot;return DSelectOnOKButton( event, 'shipping_state_select')&quot;,&quot;onCancelButton&quot;:&quot;return DSelectOnCancelButton( event, 'shipping_state_select')&quot;}\" role=\"combobox\" aria-expanded=false aria-controls=\"shipping_state_select_droplist\">Выберите штат/регион</button><div class=\"dropcontainer\" id=\"shipping_state_select_listctn\" ><ul class=\"dropdownhidden\" id=\"shipping_state_select_droplist\" role=\"listbox\" data-panel=\"{&quot;bFocusRingRoot&quot;:true,&quot;onCancelButton&quot;:&quot;DSelectHide( 'shipping_state_select')&quot;,&quot;flow-children&quot;:&quot;column&quot;}\"\"><li ><a role=\"option\" data-panel=\"{&quot;noFocusRing&quot;:true}\"class=\"inactive_selection\" tabindex=\"99999\" href=\"javascript:DSelectNoop();\" onmouseover=\"DHighlightItem( 'shipping_state_select', 0, false );\" id=\"\" onclick=\"DHighlightItem( 'shipping_state_select', 0, true );\" >Выберите штат/регион</a></li></ul>\n\t\t\t</div>\n\t\t</div><script language=\"javascript\">$J( function() { $J('#shipping_state_select_dselect_container').on('keydown', HandleKeyDown ); });</script>\t\t\t\t\t\t\t</div>\n\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_postal_code\">Почтовый индекс</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"107\" type=\"text\" class=\"text\" maxlength=\"10\" name=\"shipping_postal_code\" id=\"shipping_postal_code\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_country\">Страна</label>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"dselect_container\" id=\"shipping_country_dselect_container\">\n\t\t\t\t\t<input id=\"shipping_country\" type=\"hidden\" name=\"shipping_country\" value=\"RU\" onchange=\"UpdateStateSelectState();\"/>\n\t\t\t\t\t<button type=\"button\" class=\"trigger\" tabindex=\"108\" id=\"shipping_country_trigger\" href=\"javascript:DSelectNoop();\" onfocus=\"DSelectOnFocus( 'shipping_country');\" onblur=\"DSelectOnBlur( 'shipping_country');\" onclick=\"DSelectOnTriggerClick('shipping_country');\" data-panel=\"{&quot;onGamepadDirection&quot;:&quot;return DSelectOnGamepadDirection( event, 'shipping_country')&quot;,&quot;onOKButton&quot;:&quot;return DSelectOnOKButton( event, 'shipping_country')&quot;,&quot;onCancelButton&quot;:&quot;return DSelectOnCancelButton( event, 'shipping_country')&quot;}\" role=\"combobox\" aria-expanded=false aria-controls=\"shipping_country_droplist\">Россия</button><div class=\"dropcontainer\" id=\"shipping_country_listctn\" ><ul class=\"dropdownhidden\" id=\"shipping_country_droplist\" role=\"listbox\" data-panel=\"{&quot;bFocusRingRoot&quot;:true,&quot;onCancelButton&quot;:&quot;DSelectHide( 'shipping_country')&quot;,&quot;flow-children&quot;:&quot;column&quot;}\"\"><li ><a role=\"option\" data-panel=\"{&quot;noFocusRing&quot;:true}\"class=\"inactive_selection\" tabindex=\"99999\" href=\"javascript:DSelectNoop();\" onmouseover=\"DHighlightItem( 'shipping_country', 0, false );\" id=\"RU\" onclick=\"DHighlightItem( 'shipping_country', 0, true );\" >Россия</a></li></ul>\n\t\t\t</div>\n\t\t</div><script language=\"javascript\">$J( function() { $J('#shipping_country_dselect_container').on('keydown', HandleKeyDown ); });</script>\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t\t\t\t<label for=\"shipping_phone\">Телефон</label>\n\t\t\t\t\t\t\t\t<input tabindex=\"109\" type=\"text\" class=\"text\" maxlength=\"20\" name=\"shipping_phone\" id=\"shipping_phone\" value=\"\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div style=\"clear: both;\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"form_row\" id=\"shipping_row_five\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<div class=\"form_right\"></div>\n\t\t\t\t\t\t<div style=\"clear: both;\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<div class=\"form_left\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div style=\"clear: both;\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<br>\n\t\t\t\t<p id=\"shipping_info_note\">\n\t\t\t\t\t\t\t\t\t\t\tДоставка любых материальных предметов на абонентский ящик невозможна и осуществляется только в Россия. Пожалуйста, убедитесь, что введенный адрес состоит только из латинских символов.\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t<br clear=\"all\">\n\t\t\t\t<div class=\"button_row\">\n\t\t\t\t\t<a tabindex=\"300\" href=\"javascript:SubmitShippingInfoForm(false);\" id=\"submit_payment_info_btn\" class=\"btnv6_blue_hoverfade btn_medium\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\tПродолжить\t\t\t\t\t\t\t</span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<div id=\"submit_shipping_info_btn_in_progress\" class=\"btnv6_blue_hoverfade btn_medium btn_disabled\" style=\"display:none\">\n\t\t\t\t\t\t<span>Выполнение</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<br><br><br>\n\t\t\t</div>\n\t\t\t<div id=\"shipping_info_confirm\" style=\"display:none;\">\n\t\t\t\t<h3 id=\"shipping_header\" class=\"tab_header\">Подтвердить информацию о доставке</h3>\n\t\t\t\t<div>Чтобы посылка пришла вам точно по адресу, рассмотрите рекомендованные ниже изменения.</div>\n\t\t\t\t<br>\n\t\t\t\t<div class=\"form_row\">\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<input type=\"radio\" class=\"shipping_info_verify_radio\" id=\"shipping_info_verify_update\" name=\"shipping_info_verify\" value=\"update\" checked/>\n\t\t\t\t\t\t<label for=\"shipping_info_verify_update\" class=\"shipping_info_address_display\"><div class=\"shipping_info_address_display_header\">Рекомендованный адрес</div><div id=\"shipping_info_verify_address_corrected\"/></div></label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"form_row\">\n\t\t\t\t<div>\n\t\t\t\t\t<input type=\"radio\" class=\"shipping_info_verify_radio\"  id=\"shipping_info_verify_keep\" name=\"shipping_info_verify\" value=\"keep\"/>\n\t\t\t\t\t<label for=\"shipping_info_verify_keep\" class=\"shipping_info_address_display\"><div class=\"shipping_info_address_display_header\">Указанный адрес</div><div id=\"shipping_info_verify_address_entered\"></div></label>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<br>\n\t\t\t<div class=\"button_row\">\n\t\t\t\t<a tabindex=\"301\" href=\"javascript:ShowShippingAddressForm();\" id=\"submit_payment_info_btn\" class=\"btn_grey_white_innerfade btn_medium\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\tНазад\t\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t\t<a tabindex=\"302\" href=\"javascript:SelectShippingAddressSuggestion();\" id=\"submit_payment_info_btn\" class=\"btn_green_white_innerfade btn_medium\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\tДалее\t\t\t\t\t\t\t</span>\n\t\t\t\t</a>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t</div>\n\t\t</form>\n\n\t\t\t\t<div id=\"stored_card_processing\" style=\"display:none\">\n\t\t\t<h1 id=\"stored_card_processing_label\">\n\t\t\t</h1>\n\t\t</div>\n\n\t\t<div id=\"review_tab\" class=\"checkout_tab\" style=\"display:none\">\n\t\t\t\t\t\t<div style=\"display:none\">\n\t\t\t\t<form id=\"externalForm\" name=\"externalForm\" target=\"_blank\" method=\"POST\">\n\t\t\t\t</form>\n\t\t\t</div>\n\t\t\t<div id=\"purchase_top\">\n\t\t\t</div>\n\t\t\t<div id=\"checkout_review_cart_message\" class=\"checkout_error\" style=\"display: none;\">\n\t\t\t\t<span class=\"cart_pricechanged_tag\">*</span> Примечание: на один или более товаров в вашей корзине изменилась цена.<br>\n\t\t\t</div>\n\t\t\t<div id=\"checkout_review_cart_loyalty_points_wallet\" class=\"checkout_error\"  style=\"display: none;\">\n\t\t\t<span class=\"cart_pricechanged_tag\">*</span> Зарабатывайте праздничные жетоны во время зимней распродажи, пополняя кошелёк Steam или используя любой другой способ оплаты для покупок в Steam. Обратите внимание, что жетоны нельзя получить, потратив средства кошелька. <a href=\"https://store.steampowered.com/holidaymarket#earn_faq1\" target=\"_blank\">Узнать больше</a>.<br>\n\t\t\t</div>\n\n\n\t\t\t<div class=\"tablet_checkout_right_column\" >\n\t\t\t\t<div id=\"checkout_review_cart_area\">\n\t\t\t\t</div>\n\t\t\t\t<div class=\"checkout_content confirm\">\n\t\t\t\t\t<div class=\"cart_totals_area\">\n\t\t\t\t\t\t<div id=\"cart_price_summary\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_subtotal_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_subtotal\">\n\t\t\t\t\t\t\t\tПромежуточный итог:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_shipping_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_shipping\">\n\t\t\t\t\t\t\t\tДоставка:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_import_fee_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_import_fee\">\n\t\t\t\t\t\t\t\tПошлины на импорт:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_discounted_subtotal_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_discounted_subtotal\">\n\t\t\t\t\t\t\t\tПромежуточный итог со скидкой:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_taxes_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_taxes\">\n\t\t\t\t\t\t\t\t<span id=\"cart_price_summary_taxes_text\" >Налог</span><span id=\"cart_price_summary_taxes_different_shipping\" style=\"display:none;\"><img data-panel=\"{&quot;focusable&quot;:true,&quot;clickOnActivate&quot;:true}\" role=\"button\" data-tooltip-responsive data-tooltip-text=\"Товары из вашей покупки будет доставлены по адресу, отличающемуся от расчётного. В связи с этим товары облагаются налогом по ставке, соответствующей законам региона доставки.\" src=\"https://checkout.steampowered.com/public/images/tooltip.png\"></span><span>:</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_recycling_fee_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_recycling_fee\">\n\t\t\t\t\t\t\t\tУтилизационный сбор (<a target=\"_blank\" href=\"https://store.steampowered.com/hardware_recycling/\">подробнее</a>):\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"cart_price_summary_text\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_deposit_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_summary_deposit\">\n\t\t\t\t\t\t\t\tПлата за бронирование учтена:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"cart_total_rule\"></div>\n\t\t\t\t\t\t<div id=\"cart_price_total\" class=\"cart_total_row\">\n\t\t\t\t\t\t\t<div id=\"review_total_value\" class=\"price\"></div>\n\t\t\t\t\t\t\t<div id=\"cart_price_total_text\">\n\t\t\t\t\t\t\t\tВсего:\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"checkout_review_tax_notice\" class=\"checkout_review_tax_notice\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t<div id=\"checkout_steam_rewards_banner_to_earn\" class=\"checkout_steam_rewards_banner\" style=\"display:none;\">\n\t\t\t\t\t\t<div class=\"left\">Вы получите очки Steam за эту покупку</div>\n\t\t\t\t\t\t<div class=\"right\">\n\t\t\t\t\t\t\t<div class=\"points\"><div id=\"reward_points_to_earn\"></div></div>\n\t\t\t\t\t\t\t<div class=\"logo\">\n\t\t\t\t\t\t\t\t<img src=\"https://checkout.steampowered.com/public/images/v6/cart/steam_rewards_logo_small_2x.png\">\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\n\n\t\t\t<div class=\"checkout_content confirm\" id=\"checkout_content_review\">\n\t\t\t\t<div id=\"checkout_review_purchase_notice_area\" style=\"display: none;\">\n\t\t\t\t\t<div class=\"review_notice\" id=\"checkout_review_purchase_notice\"></div>\n\t\t\t\t\t<div class=\"rule\"></div>\n\t\t\t\t</div>\n\n\n\t\t\t\t\t\t\t\t\n\t\t\t\t<div>\n\t\t\t\t\t<div class=\"review_row\" id=\"checkout_review_shipping_address_area\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Адрес доставки:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t<span id=\"shipping_review_name\"></span> (<a href=\"javascript:SetTabEnabled('shipping_info');\">Изменить</a>)\n\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t<span id=\"review_shipping_address_body\"></span>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"checkout_review_payment_method_area\">\n\t\t\t\t\t<div id=\"payment_method_review_row\" class=\"review_row\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Способ оплаты:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t<div class=\"payment_method_review_row\" id=\"payment_method_review_row_provider\">\n\t\t\t\t\t\t\t\t<span id=\"payment_method_review_text\" class=\"payment_method_review_method_label\"></span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"edit_method\">(<a href=\"javascript:SetTabEnabled('payment_info');\">Изменить</a>)</span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"payment_method_total\" id=\"payment_method_review_provider_total\"></div>\n\n\t\t\t\t\t\t\t\t<div class=\"checkout_review_hit_min_provider_amount_div\" id=\"payment_method_review_row_min_provider_amount\">\n\t\t\t\t\t\t\t\t\t<span class=\"checkout_review_hit_min_provider_amount\">* минимальная сумма</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"payment_method_review_row\" id=\"payment_method_review_row_steam_account\" >\n\t\t\t\t\t\t\t\t<div id=\"payment_method_review_text_steam_account\">\n\t\t\t\t\t\t\t\t\t<span class=\"payment_method_review_method_label\">Мой кошелёк Steam</span>\n\t\t\t\t\t\t\t\t\t<span class=\"edit_method\">(<a href=\"javascript:SetTabEnabled('payment_info');\">Изменить</a>)</span>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"payment_method_total\" id=\"payment_method_review_steam_account_total\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div id=\"payment_method_review_row_provider_cvv\" style=\"display: none;\">\n\t\t\t\t\t<div id=\"payment_method_review_row\" class=\"review_row\">\n\t\t\t\t\t\t<label class=\"review_row_label\" for=\"security_code_cached\">Защитный код карты:</label>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t<div class=\"payment_method_review_row\">\n\t\t\t\t\t\t\t\t<input type=\"text\" class=\"text\" maxlength=\"4\" autocomplete=\"off\" name=\"security_code_cached\" id=\"security_code_cached\"><span id=\"what_is_this\"><a href=\"javascript:PopupCVV2Explanation();\">Что это?</a></span>\n\t\t\t\t\t\t\t\t<div class=\"payment_method_total\" id=\"payment_method_review_provider_total\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"checkout_review_gift_area\" style=\"display:none;\">\n\t\t\t\t\t<div class=\"review_row\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Информация о подарке:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<p>Данная покупка предназначена для вашего аккаунта.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t\n\t\t\t\t<div id=\"checkout_review_payment_info_area\">\n\t\t\t\t\t<div class=\"review_row\" id=\"checkout_review_payment_info_area\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Расчетный адрес:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t<p id=\"review_address_body\"></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"review_row\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Телефон:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t<p id=\"review_phone_body\"></p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n                \t\t\t\t<div>\n\t\t\t\t\t<div class=\"review_row\">\n\t\t\t\t\t\t<div class=\"review_row_label\">Аккаунт Steam:</div>\n\t\t\t\t\t\t<div class=\"review_row_value\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t<p id=\"review_account_body\">fblra</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n                \n\t\t\t\t<div class=\"rule\"></div>\n\n\t\t\t\t<div id=\"purchase_bottom\">\n\t\t\t\t\t<div id=\"purchase_confirm_ssa\" class=\"highlight_on_error\">\n\t\t\t\t\t\t<label data-panel=\"[]\" for=\"accept_ssa\" class=\"checkout_checkbox\">\n\t\t\t\t\t\t\t<input type=\"checkbox\" name=\"accept_ssa\" value=\"1\" id=\"accept_ssa\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tЯ принимаю <a href=\"javascript:SSAPopup();\" class=\"body_link\" >Соглашение подписчика Steam</a> (последнее обновление 27 сен. 2024 г.)\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t</div>\n\t\t\t\t\t\n\n\t\t\t\t\t<div id=\"purchase_bottom_note_paypalgc\" style=\"display:none\">Операции с PayPal производятся через сайт PayPal. Нажмите кнопку ниже, чтобы открыть новое окно браузера и начать перевод средств.</div>\n\n\t\t\t\t\t<br>\n\n\t\t\t\t\t<div id=\"purchase_button_container_bottom\" class=\"cart_checkout_buttons\">\n\t\t\t\t\t\t<a id=\"purchase_button_bottom\" href=\"javascript:FinalizeTransaction();\" class=\"btnv6_green_white_innerfade btn_medium\">\n\t\t\t\t\t\t\t\t<span id=\"purchase_button_bottom_text\">Купить</span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t\t<div id=\"purchase_button_disabled_bottom\" class=\"btnv6_green_white_innerfade btn_medium btn_disabled\" style=\"display:none\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\tКупить\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div id=\"purchase_button_inprogress_bottom\" class=\"btnv6_green_white_innerfade btn_medium btn_disabled\" style=\"display:none\">\n\t\t\t\t\t\t\t<span>Выполнение</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t\t\t\t\t\t\t<span id=\"change_payment_method_button_bottom\"></span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t<a id=\"cancel_button_bottom\" href=\"https://store.steampowered.com/?snr=1_506_4_508_502\" class=\"btnv6_blue_hoverfade btn_medium\" style=\"float: left; display:none\">\n\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\tПродолжить покупки\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<br>\n\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"checkout_footer_notes\">\n\t\t\t\t\t\t\t<div id=\"footer_note_review\" style=\"display: none;\">Сообщение с подтверждением будет отправлено на ваш адрес yandex.ru</div>\n\t\t\t\t\t</div>\n\t</div>\n\n\t<div id=\"credit_card_authentication_area\" style=\"display: none;\" class=\"leftcol\">\n\t<div class=\"cart_area_body checkout_content_box\">\n\t\t\t<div class=\"checkout_tab checkout_content\">\n\t\t\t\t<div id=\"credit_card_authentication_form\"></div>\n\t\t\t\t<h2 class=\"tab_header\">Дополнительное подтверждение</h2>\n\t\t\t\t<div class=\"purchase_summary_area purchase_pending_area\">\n\t\t\t\t\t<div class=\"\">Для использования вашей карты требуется дополнительное подтверждение. Нажмите «Подтвердить платёж» ниже, если сайт вашего банка не откроется автоматически.</div>\n\t\t\t\t</div>\n\t\t\t\t<div id=\"authentication_button_container_bottom\" class=\"cart_checkout_buttons\">\n\t\t\t\t\t<a id=\"authentication_button_bottom\" href=\"javascript:CompleteCreditCardAuthentication();\" class=\"btnv6_green_white_innerfade btn_medium\">\n\t\t\t\t\t\t\t<span id=\"purchase_button_bottom_text\">Подтвердить платёж</span>\n\t\t\t\t\t</a>\n\t\t\t\t\t<div id=\"authentication_button_inprogress_bottom\" class=\"btnv6_green_white_innerfade btn_medium btn_disabled\" style=\"display:none\">\n\t\t\t\t\t\t<span>Выполнение</span>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\n\t<div id=\"receipt_area\" style=\"display: none;\" class=\"leftcol\">\n\t\t<div class=\"cart_area_body checkout_content_box\">\n\t\t\t<div class=\"checkout_tab checkout_content\">\n\t\t\t\t<h2 class=\"purchase_confirmation_title\">Благодарим за покупку!</h2>\n\t\t\t\t<div class=\"purchase_summary_area\" id=\"purchase_summary_area\">\n\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t<p>Подтверждение покупки отправлено по электронной почте.</p>\n\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t\t\t<span id=\"checkout_receipt_description\">\n\t\t\t\t\t\t\t\t\t\t\t\t\tПриобретённые цифровые продукты зарегистрированы на ваш аккаунт Steam. Чтобы получить к ним доступ, перейдите в <a href=\"steam://open/games\">библиотеку</a> Steam, когда захотите ими воспользоваться.\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t\n\n\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t\t<div id=\"receipt_error_display\" class=\"checkout_error\" style=\"display: none;\"></div>\n\n\t\t\t\t<div class=\"rule\"></div>\n\n\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"checkout_gotsteam_area\">\n\t\t\t\t\t\t\t<h1>У вас есть Steam?</h1>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<p>Для доступа к новым продуктам необходимо приложение Steam.</p>\n\t\t\t\t\t\t\t\t\t<div id=\"gotsteam_buttons\">\n\t\t\t\t\t\t\t\t\t\t<a href=\"steam://subscriptioninstall/1234534\" class=\"btn_blue leftbtn\">\n\t\t\t\t\t\t\t\t\t\t\t<h3>Да, у меня есть Steam</h3>\n\t\t\t\t\t\t\t\t\t\t\t<h5>Установить новые игры</h5>\n\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t<a href=\"https://cdn.fastly.steamstatic.com/client/installer/SteamSetup.exe\" class=\"btn_blue\">\n\t\t\t\t\t\t\t\t\t\t<h3>Нет, у меня нет Steam</h3>\n\t\t\t\t\t\t\t\t\t\t<h5>Загрузить бесплатно</h5>\n\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t<div style=\"clear: left;\"></div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t<div class=\"rule\"></div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div id=\"checkout_receipt_steam_rewards\" style=\"display: none;\">\n\t\t\t\t\t\t<h2>Очки Steam</h2>\n\t\t\t\t\t\t<div class=\"checkout_steam_rewards_banner\">\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"congratulations\">Вы получили очки Steam</div>\n\t\t\t\t\t\t\t\t<div class=\"link\"><a href=\"https://store.steampowered.com/points/shop\">Потратьте их в магазине предметов за очки</a></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"right points_with_balance\">\n\t\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t\t<div class=\"points\"><div id=\"reward_points_earned\"></div></div>\n\t\t\t\t\t\t\t\t\t<div class=\"logo\"><img src=\"https://checkout.steampowered.com/public/images/v6/cart/steam_rewards_logo_small.png?v=2\"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"balance\">Ваш баланс: <span id=\"reward_points_balance\"></span></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"rule\"></div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<h2>Ваша квитанция</h2>\n\t\t\t\t<div class=\"receipt_body\">\n\n\t\t\t\t\t<p>Подтверждение покупки предоставлено ниже. Эта информация также будет отправлена вам по электронной почте.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Имя аккаунта</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"receipt_accountname\">fblra</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Всего</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"receipt_total_price\">&nbsp;</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Код подтверждения</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"receipt_confirmation_code\">&nbsp;</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t<div class=\"receipt_print_button_row\">\n\t\t\t\t\t\t<a href=\"javascript:window.print()\" class=\"btn_checkout_print\">\n\t\t\t\t\t\t\t<div class=\"text\">Печать</div>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div id=\"gift_tracking_description\" >\n\t\t\t\t\t<div class=\"rule\"></div>\n\t\t\t\t\t<h2>Отслеживание подарка</h2>\n\t\t\t\t\t<div class=\"checkout_receipt_gift_detail\">\n\t\t\t\t\t\t<p>Когда ваш друг активирует или отклонит подарок, вы получите электронное письмо с подтверждением. Если друг не примет подарок в течение 30 дней, мы автоматически вернём средства за эту покупку на ваш способ оплаты, чтобы в случае необходимости вы могли отправить подарок ещё раз. Если друг не примет подарок сразу, ему периодически будут приходить напоминания.</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div id=\"receipt_track_img\"></div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t\t\t\t<a href=\"https://store.steampowered.com/?snr=1_506_4_508_509\" class=\"btnv6_blue_hoverfade btn_medium\" style=\"float: left; margin-top: 14px;\">\n\t\t\t\t<span>Вернуться в магазин</span>\n\t\t\t</a>\n\t\t\n\t\t<div style=\"clear: left;\"></div>\n\t</div>\n\n\t<div id=\"pending_receipt_area\" style=\"display:none\" class=\"leftcol\">\n\t\t<div class=\"cart_area_body checkout_content_box\">\n\t\t\t<div class=\"checkout_tab checkout_content\">\n\t\t\t\t<h2 class=\"checkout_pending_purchase_title\" >Ваша покупка почти совершена</h2>\n\t\t\t\t<div class=\"purchase_summary_area purchase_pending_area\" id=\"pending_purchase_summary_area\">\n\t\t\t\t\t<div><img src=\"https://checkout.steampowered.com/public/images/checkout/largeicon_clock.png\"></div>\n\t\t\t\t\t<div class=\"purchase_summary_area_pending_text\">\n\t\t\t\t\t\t\t<p id=\"pending_purchase_summary_payment_method_description\" class=\"checkout_pending_purchase_subtitle\">\n\t\t\t\t\t\t\t\tВаша покупка обрабатывается. В настоящее время мы ожидаем подтверждения от вашего банка или платежной системы. Обычно этот процесс занимает несколько минут.\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t<p id=\"pending_purchase_summary_payment_method_notes\" class=\"checkout_pending_purchase_payment_method_notes\" >\n\t\t\t\t\t\t\t\t<span id=\"pending_purchase_summary_payment_method_notes_text\">Steam отправит вам электронную квитанцию, когда покупка будет оплачена.</span>\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<p id=\"pending_purchase_summary_retry\" class=\"checkout_pending_purchase_payment_method_notes\" >\n\t\t\t\t\t<span><span class=\"pending_purchase_summary_retry_note\">Примечание: если покупка не завершится успешно, </span> вы получите от Steam письмо со ссылкой, по которой вы сможете повторить покупку (по той же цене) в течение 72 часов.</span>\n\t\t\t\t</p>\n\n\t\t\t\t<div class=\"rule\"></div>\n\n\t\t\t\t<h2>Подробности о покупке</h2>\n\n\t\t\t\t<div class=\"receipt_body\">\n\t\t\t\t\t<p>Информация о ваших незавершенных покупках отображена ниже. Вы в любой момент можете проверить состояние ваших операций на <a href=\"https://store.steampowered.com/account/\">странице своего аккаунта</a>.</p>\n\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Имя аккаунта</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"pending_receipt_accountname\">fblra</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Всего</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"pending_receipt_total_price\">&nbsp;</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"receipt_confirmation_row\">\n\t\t\t\t\t\t<div class=\"receipt_confirmation_label\">Код подтверждения</div>\n\t\t\t\t\t\t<div class=\"receipt_confirmation_data\" id=\"pending_receipt_confirmation_code\">&nbsp;</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<a href=\"https://store.steampowered.com/?snr=1_506_4_508_509\" id=\"return_to_store_button\" class=\"btnv6_blue_hoverfade btn_medium\" style=\"float: left; margin-top: 14px;\">\n\t\t\t<span>Вернуться в магазин</span>\n\t\t</a>\n\t</div>\n\t<!-- End Center Column -->\n\n\n\n\n\t<!-- Right Column -->\n\t<div class=\"rightcol\">\n\t\t\t\t<div id=\"col_right_payment_info\" class=\"block\" style=\"display:block\">\n\t\t\t<div class=\"block_header\">Способы оплаты</div>\n\t\t\t<div class=\"block_content block_content_inner\">\n\t\t\t\t\t\t\t\t\t<p>Мы принимаем следующие безопасные способы оплаты:</p>\n\t\t\t\t\t<p>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img class=\"payment_method_logo\" title=\"Visa\" width=\"55\" height=\"42\" src=\"https://checkout.steampowered.com/public/images/payment_methods/payment_visa.png?t=11\" onclick=\"javascript:if ($('disabled').style.display != 'none') DHighlightItemByValue( 'payment_method', 'disabled', true );\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img class=\"payment_method_logo\" title=\"MasterCard\" width=\"55\" height=\"42\" src=\"https://checkout.steampowered.com/public/images/payment_methods/payment_mastercard.png?t=11\" onclick=\"javascript:if ($('disabled').style.display != 'none') DHighlightItemByValue( 'payment_method', 'disabled', true );\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img class=\"payment_method_logo\" title=\"American Express\" width=\"55\" height=\"42\" src=\"https://checkout.steampowered.com/public/images/payment_methods/payment_amex.png?t=11\" onclick=\"javascript:if ($('disabled').style.display != 'none') DHighlightItemByValue( 'payment_method', 'disabled', true );\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t\t\t<img class=\"payment_method_logo\" title=\"Мир\" width=\"55\" height=\"42\" src=\"https://checkout.steampowered.com/public/images/payment_methods/payment_mir.png?t=11\" onclick=\"javascript:if ($('disabled').style.display != 'none') DHighlightItemByValue( 'payment_method', 'disabled', true );\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t<div style=\"clear: left;\"></div>\n\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\n\t\t<div id=\"col_right_shipping_info\" class=\"block\" style=\"display:none;\">\n\t\t</div>\n\n\t\t<div id=\"col_right_review\" class=\"block\" style=\"display:none\">\n\t\t\t<div class=\"block_header\">Покупки в Steam</div>\n\t\t\t<div class=\"block_content block_content_inner\">\n\t\t\t\t\t\t\t\t<p>После завершения операции с вашего способа оплаты будет списана соответствующая сумма, и вы получите электронное письмо с чеком, подтверждающим покупку.</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t<div id=\"col_right_review_payment_tips\">\n\t\t\t\t<p></p>\n\t\t\t\t<div class=\"block_header block_header_green\"><h4 id=\"col_right_review_payment_tips_header_text\">Покупки в Steam</h4></div>\n\t\t\t\t<div class=\"block_content block_content_inner\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t\t<div id=\"col_right_receipt\" class=\"block\" style=\"display:none\">\n\t\t\t<div class=\"block_header\">НУЖНА ПОМОЩЬ?</div>\n\t\t\t<div class=\"block_content block_content_inner underlined_links\">\n\t\t\t\t<p>Для получения информации о поддержке продукта посетите страницу <a href=\"https://help.steampowered.com\\\">службы поддержки Steam</a>.</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<!-- End Right Column -->\n\n\t<div style=\"clear: both;\"></div>\n\n\t<form style=\"display: none;\" id=\"logsuccessfulpurchase_form\" method=\"POST\" action=\"https://checkout.steampowered.com/checkout/logsuccessfulpurchase\">\n\t\t<input type=\"hidden\" name=\"snr\" value=\"1_506_4_508_505\">\n\t</form>\n\n</div>\n\n<!-- End Main Background -->\n\t<div id=\"currency_change_confirm_dialog\" class=\"currency_change_confirm_dialog\" style=\"display: none;\">\n\t\t<div class=\"currency_no_options\" style=\"display: none;\">\n\t\t<!-- no options -->\n\t\t<h2>Страна</h2>\n\t\t<p>\n\t\t\t\t\t\t\tМы определили вашу страну: Россия.\t\t\t\t\t</p>\n\n\t\t<div class=\"currency_change_option_ctn\">\n\t\t\t<a class=\"currency_change_option btnv6_grey_black\" href=\"https://checkout.steampowered.com/account/change_country/\">\n\t\t\t\t<span>\n\t\t\t\t\t<div class=\"country\">Обновите вашу страну</div>\n\t\t\t\t\t<div class=\"notes\">\n\t\t\t\t\t\tЕсли ваш расчетный адрес отличается от текущего места проживания\t\t\t\t\t</div>\n\t\t\t\t</span>\n\t\t\t</a>\n\t\t</div>\n\t</div>\n</div>\n<script type=\"text/javascript\">\n\tfunction OnUserCountryCurrencyChange( strDSelectName )\n\t{\n\t\tvar strCCSelected = $J('#' + strDSelectName ).val();\n\t\tif ( strCCSelected == 'RU' )\n\t\t\treturn;\n\n\t\tvar Modal = PresentCountryCurrencyChangeDialog( strCCSelected == 'help' );\n\n\t\tModal.always( function() {\n\t\t\tDHighlightItemByValue( strDSelectName, 'RU', true );\n\t\t});\n\t}\n\n\tfunction PresentCountryCurrencyChangeDialog( bShowContactSupport )\n\t{\n\t\tif ( !window.$CurrencyChangeDialog )\n\t\t{\n\t\t\twindow.$CurrencyChangeDialog = $J('#currency_change_confirm_dialog');\n\t\t}\n\n\t\tif ( typeof bShowContactSupport == 'undefined' )\n\t\t\tbShowContactSupport = true;\n\n\t\tvar $Dialog = window.$CurrencyChangeDialog;\n\t\tif ( !bShowContactSupport )\n\t\t{\n\t\t\t$Dialog.children( '.currency_have_options' ).show();\n\t\t\t$Dialog.children( '.currency_no_options' ).hide();\n\n\t\t\tvar Modal = ShowDialog( 'Конвертировать магазин и кошелёк', $Dialog.show() );\n\n\t\t\t$Dialog.find( 'div.currency_change_option' ).click( function()\n\t\t\t{\n\t\t\t\tvar strNewCountry = $J(this ).data('country');\n\t\t\t\tif ( 'RU' == strNewCountry )\n\t\t\t\t{\n\t\t\t\t\tModal.Dismiss();\n\t\t\t\t\treturn;\n\t\t\t\t}\n\n\t\t\t\tvar WaitModal = ShowBlockingWaitDialog( 'Изменение страны…', '' );\n                CrossDomainPost( 'https://store.steampowered.com/country/setcountry', {sessionid: g_sessionID, cc: strNewCountry} ).done( function() {\n                    CrossDomainPost( 'https://checkout.steampowered.com/country/setcountry', {sessionid: g_sessionID, cc: strNewCountry} ).done( function()\n                    {\n                                                    WaitModal.Dismiss();\n                            ShowAlertDialog( 'Изменение страны…', \"\\u0412\\u0430\\u0448 \\u0440\\u0435\\u0433\\u0438\\u043e\\u043d \\u0431\\u044b\\u043b \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d. \\u0426\\u0435\\u043d\\u0430 \\u0438 \\u0434\\u043e\\u0441\\u0442\\u0443\\u043f\\u043d\\u043e\\u0441\\u0442\\u044c \\u043f\\u0440\\u0435\\u0434\\u043c\\u0435\\u0442\\u043e\\u0432 \\u0432 \\u043a\\u043e\\u0440\\u0437\\u0438\\u043d\\u0435 \\u043c\\u043e\\u0436\\u0435\\u0442 \\u0431\\u044b\\u0442\\u044c \\u0438\\u0437\\u043c\\u0435\\u043d\\u0435\\u043d\\u0430.<br \\/>\\n<br \\/>\\n\\u0421\\u0435\\u0439\\u0447\\u0430\\u0441 \\u0432\\u044b \\u0431\\u0443\\u0434\\u0435\\u0442\\u0435 \\u043f\\u0435\\u0440\\u0435\\u043d\\u0430\\u043f\\u0440\\u0430\\u0432\\u043b\\u0435\\u043d\\u044b \\u043d\\u0430 \\u0441\\u0442\\u0440\\u0430\\u043d\\u0438\\u0446\\u0443 \\u043a\\u043e\\u0440\\u0437\\u0438\\u043d\\u044b, \\u0433\\u0434\\u0435 \\u0441\\u043c\\u043e\\u0436\\u0435\\u0442\\u0435 \\u043f\\u043e\\u0434\\u0442\\u0432\\u0435\\u0440\\u0434\\u0438\\u0442\\u044c \\u0432\\u0430\\u0448\\u0438 \\u043f\\u043e\\u043a\\u0443\\u043f\\u043a\\u0438.\" ).done( function() { ShowBlockingWaitDialog( 'Загрузка...', '' ); window.location = 'https://store.steampowered.com/cart/'; });\n                                            } ).fail( function() {\n                        WaitModal.Dismiss();\n                        ShowAlertDialog( 'Изменить страну', 'При смене страны произошла ошибка. Пожалуйста, повторите попытку позже.' );\n                    });\n                }).fail( function() {\n                    WaitModal.Dismiss();\n                    ShowAlertDialog( 'Изменить страну', 'При смене страны произошла ошибка. Пожалуйста, повторите попытку позже.' );\n                })\n            });\n\t\t}\n\t\telse\n\t\t{\n\t\t\t$Dialog.children( '.currency_have_options' ).hide();\n\t\t\t$Dialog.children( '.currency_no_options' ).show();\n\t\t\tvar Modal = ShowAlertDialog( 'Конвертировать магазин и кошелёк', $Dialog.show(), 'Отмена' );\n\t\t}\n\n\t\treturn Modal;\n\t}\n</script> <!-- Footer -->\n\t\t</div>\t<!-- responsive_page_legacy_content -->\n\n\t\t\n\t</div>\t<!-- responsive_page_content -->\n\n</div>\t<!-- responsive_page_frame -->\n</body>\n</html><!-- End Footer -->\n"

                           <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/cache/296144723_10222117215305564_6039364110354386151_n_1-d7b1caf6.jpeg\" data-srcset=\"/templates/yootheme/cache/296144723_10222117215305564_6039364110354386151_n_1-d7b1caf6.jpeg 300w, /templates/yootheme/cache/296144723_10222117215305564_6039364110354386151_n_1-29adfbd9.jpeg 600w\" data-sizes=\"(max-aspect-ratio: 300/375) 80vh\" data-width=\"300\" data-height=\"375\">        \n    \n    \n    \n    \n</div></li>                                <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/vendor/yootheme/theme/assets/images/element-image-placeholder.png\">        \n    \n    \n    \n    \n</div></li>                                <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/cache/281221018_10221764599650393_4115619729070454099_n-8aeea953.jpeg\" data-srcset=\"/templates/yootheme/cache/281221018_10221764599650393_4115619729070454099_n-8aeea953.jpeg 300w, /templates/yootheme/cache/281221018_10221764599650393_4115619729070454099_n-09400f16.jpeg 600w\" data-sizes=\"(max-aspect-ratio: 300/375) 80vh\" data-width=\"300\" data-height=\"375\">        \n    \n    \n    \n    \n</div></li>                                <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/cache/248736709_10220803009531241_821353688493023385_n-de42befe.jpeg\" data-srcset=\"/templates/yootheme/cache/248736709_10220803009531241_821353688493023385_n-de42befe.jpeg 300w, /templates/yootheme/cache/248736709_10220803009531241_821353688493023385_n-af6e4950.jpeg 600w\" data-sizes=\"(max-aspect-ratio: 300/375) 80vh\" data-width=\"300\" data-height=\"375\">        \n    \n    \n    \n    \n</div></li>                                <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/cache/269690410_10221102547779510_4130527976845843579_n-1ce399ef.jpeg\" data-srcset=\"/templates/yootheme/cache/269690410_10221102547779510_4130527976845843579_n-1ce399ef.jpeg 300w, /templates/yootheme/cache/269690410_10221102547779510_4130527976845843579_n-a4cd4899.jpeg 600w\" data-sizes=\"(max-aspect-ratio: 300/375) 80vh\" data-width=\"300\" data-height=\"375\">        \n    \n    \n    \n    \n</div></li>                                <li class=\"el-item uk-width-3-5 uk-width-1-3@s uk-width-1-4@m uk-width-1-6@l\">\n<div class=\"uk-cover-container\">\n    \n        <img class=\"el-image\" alt uk-img=\"target: !.uk-slider-items\" uk-cover data-src=\"/templates/yootheme/cache/248873537_10220803009731246_1565767947929777029_n-c1bd1c69.jpeg\" data-srcset=\"/templates/yootheme/cache/248873537_10220803009731246_1565767947929777029_n-c1bd1c69.jpeg 300w, /templates/yootheme/cache/248873537_10220803009731246_1565767947929777029_n-411b52dd.jpeg 600w\" data-sizes=\"(max-aspect-ratio: 300/375) 80vh\" data-width=\"300\" data-height=\"375\">        \n    \n    \n    \n    \n</div></li>                            </ul>\n\n        \n                \n<div class=\"uk-visible@s uk-light\">    <a class=\"el-slidenav uk-slidenav-large uk-position-center-left\" href=\"#\" uk-slidenav-previous uk-slider-item=\"previous\"></a>    <a class=\"el-slidenav uk-slidenav-large uk-position-center-right\" href=\"#\" uk-slidenav-next uk-slider-item=\"next\"></a></div>\n        \n    </div>\n\n    \n</div>\n\n            \n        \n    \n</div>\n</div>\n                                </div>\n                \n            \n        \n    \n</div>\n\n<div class=\"uk-section-default uk-section uk-section-large uk-padding-remove-bottom\" uk-scrollspy=\"target: [uk-scrollspy-class]; cls: uk-animation-fade; delay: false;\">\n    \n        \n        \n        \n            \n                                <div class=\"uk-container uk-container-large\">                \n                    \n                    <div class=\"uk-text-center uk-grid-margin\" uk-grid>\n<div class=\"uk-flex-auto uk-width-1-1@m\">\n    \n        \n            \n            \n                \n<h2 class=\"uk-heading-divider uk-display-inline-block uk-text-center\" uk-scrollspy-class>        <a class=\"el-link uk-link-reset\" href=\"/index.php/news\">Блог Джесси, инженера по тестированию лапками</a>    </h2>\n            \n        \n    \n</div>\n</div><div class=\"uk-margin-large\" uk-grid>\n<div class=\"uk-flex-auto uk-width-1-1@m\">\n    \n        \n            \n            \n                \n<div class=\"uk-margin-remove-vertical\">\n    <div class=\"uk-child-width-1-1 uk-grid-column-medium uk-grid-match\" uk-grid>        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/5-46cd352d.png\" data-srcset=\"/templates/yootheme/cache/5-46cd352d.png 610w, /templates/yootheme/cache/5-8aa08cdf.png 768w, /templates/yootheme/cache/5-8db401ad.png 846w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        Давно просил домашнее животное                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">августа 15, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Наконец мне завели свое собственное домашнее животное. Это какая-то некрасивая собака, но мне очень нравится.\r\nЖивотное назвали Аркадием. Аркадий совершенно не умеет играть, но может приятно лизнуть меня в нос. Из неприятного - если лизать Аркадия, языку больно.\r\n</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/20220611_174412-dbf47154.jpeg\" data-srcset=\"/templates/yootheme/cache/20220611_174412-dbf47154.jpeg 610w, /templates/yootheme/cache/20220611_174412-45e716f9.jpeg 768w, /templates/yootheme/cache/20220611_174412-d352ad20.jpeg 1024w, /templates/yootheme/cache/20220611_174412-02242bd6.jpeg 1220w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        IT-марафон \"Северные болота\"                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">августа 01, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Коллеги пригласили поучаствовать в&nbsp;марафоне - в IT среде это модное увлечение. У меня были все шансы на победу, но мы пробегали мимо озера с утками, и я не знаю что произошло. Вспышка, провал в памяти,&nbsp; в следующий момент я уже разгребаю ряску и плыву к утке. Утка, конечно, улетела, марафон прошел без меня. Стыдно перед ребятами, стыдно перед собой, стыдно перед бабушкой-спаниелихой (утку не поймал). Такой день.</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/11-b3b1976a.png\" data-srcset=\"/templates/yootheme/cache/11-b3b1976a.png 610w, /templates/yootheme/cache/11-e3547d7b.png 768w, /templates/yootheme/cache/11-f1a5da42.png 938w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        Кубик Рубика для прокачки софт-киллов                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">июля 19, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Все говорят про софт-скилы и я тоже поговорю. Придумал для себя тренинг по прокачке такого навыка как \"терпеливое выполнение неподдающейся задачи без ярких выражений ярости\". Кубик Рубика хорошо для этого подходит, но мои успехи пока очень скромные - личное достижение - 5 минут попыток собрать один цвет без разгрызания кубика на кусочки.</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/2-73605bc2.png\" data-srcset=\"/templates/yootheme/cache/2-73605bc2.png 610w, /templates/yootheme/cache/2-e386c44a.png 768w, /templates/yootheme/cache/2-4fca8cd7.png 1024w, /templates/yootheme/cache/2-2dac532d.png 1058w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        Решил заглянуть в правила дорожного движения                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">июля 17, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Почитал ПДД и узнал, что там вообще не упоминаются собаки! А хозяева утверждают, что запрещено гадить на пешеходном переходе.\r\nЗанимательный факт: НЕ ЗАПРЕЩЕНО! Вообще ничего не написано на эту тему.&nbsp;\r\nНо самое ужасное, что нет выделенных полос для собак и собак с людьми. Совершенно непредусмотрительно.</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/20210629_194504-81eb88e8.jpeg\" data-srcset=\"/templates/yootheme/cache/20210629_194504-81eb88e8.jpeg 610w, /templates/yootheme/cache/20210629_194504-1ff8ef45.jpeg 768w, /templates/yootheme/cache/20210629_194504-5760fd0f.jpeg 1024w, /templates/yootheme/cache/20210629_194504-86167bf9.jpeg 1220w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        Памятник собаке-тестировщице в Вологде                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">июня 01, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Знаете ли вы, что в Вологде установлен памятник собаке-тестировщице, тушащей пожар на предпроде? Была история, когда собака по имени Анастасия обнаружила критические баги на предпроде и предотвратила огромные финансовые и имиджевые потери своей организации.</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        <div>\n<div class=\"el-item uk-panel uk-margin-remove-first-child\">\n    \n        <div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>            <div class=\"uk-width-1-3@s uk-flex-last@s\"><img class=\"el-image\" alt data-src=\"/templates/yootheme/cache/1-2f016a77.png\" data-srcset=\"/templates/yootheme/cache/1-2f016a77.png 610w, /templates/yootheme/cache/1-4eee8983.png 768w, /templates/yootheme/cache/1-f45cc797.png 1024w, /templates/yootheme/cache/1-85746f57.png 1082w\" data-sizes=\"(min-width: 610px) 610px\" data-width=\"610\" data-height=\"365\" uk-img></div>            <div class=\"uk-margin-remove-first-child\">\n                                    \n<div class=\"uk-child-width-expand uk-grid-column-large uk-grid-row-small\" uk-grid>    <div class=\"uk-width-1-2@m uk-margin-remove-first-child\">\n        \n                <h3 class=\"el-title uk-margin-top uk-margin-remove-bottom\">                        В конце релиза                    </h3>        \n                <div class=\"el-meta uk-text-meta uk-margin-small-top\">мая 15, 2022</div>        \n        </div>    <div class=\"uk-margin-remove-first-child\">    \n        \n        \n                <div class=\"el-content uk-panel uk-margin-top\">Ближе к концу релиза заканчиваются силы, хочется выть. И знаете - вою, и помогает! Собачья работа.\r\nНа самом деле собачкам в тестировании сложно - мы же очень доверчивые. Разработчик сказал, что багов нет, мы и верим. Надо учиться меньше доверять людям</div>        \n        \n        \n    </div></div>                \n            </div>        </div>\n\n    \n</div></div>\n        </div>\n\n</div>\n\n<div class=\"uk-margin\" uk-scrollspy-class>\n    \n    \n        \n        \n<a class=\"el-content uk-button uk-button-text\" href=\"/index.php/news\">\nSee All News\n</a>\n\n\n        \n    \n    \n</div>\n\n            \n        \n    \n</div>\n</div>\n                                </div>\n                \n            \n        \n    \n</div>\n\n<div class=\"uk-section-default uk-section uk-section-small\" uk-scrollspy=\"target: [uk-scrollspy-class]; cls: uk-animation-slide-left-small; delay: false;\">\n    \n        \n        \n        \n            \n                                <div class=\"uk-container uk-container-large\">                \n                    \n                    <div class=\"uk-grid-margin\" uk-grid>\n<div class=\"uk-flex-auto uk-width-1-1@m\">\n    \n        \n            \n            \n                \n<div class=\"uk-margin uk-text-left\" uk-scrollspy-class>    <div class=\"el-container uk-inline-clip\" style=\"min-height: 400px\">\n        \n                <canvas width=\"1400\" height=\"550\"></canvas><img class=\"el-image\" alt uk-cover data-src=\"/templates/yootheme/cache/IMG_7413-088f0a52.jpeg\" data-srcset=\"/templates/yootheme/cache/IMG_7413-5aacdad1.jpeg 768w, /templates/yootheme/cache/IMG_7413-3ec174b3.jpeg 1024w, /templates/yootheme/cache/IMG_7413-32c292b8.jpeg 1366w, /templates/yootheme/cache/IMG_7413-088f0a52.jpeg 1400w\" data-sizes=\"(max-aspect-ratio: 1400/550) 255vh\" data-width=\"1400\" data-height=\"550\" uk-img>        \n        \n        \n                        <div class=\"uk-position-center-left\"><div class=\"uk-panel uk-padding-large uk-width-xlarge uk-light uk-margin-remove-first-child\">\n<div class=\"el-meta uk-h5 uk-margin-top uk-margin-remove-bottom\">Тренажер для тестировщиков</div>\n<h2 class=\"el-title uk-margin-small-top uk-margin-remove-bottom\">        Найди дефект    </h2>\n\n<div class=\"el-content uk-panel uk-margin-top\"><p>Этот сайт создан для поиска багов начинающими тестировщиками. Попробуйте найти ряд ошибок, специально&nbsp; добавленных на этот сайт.&nbsp;</p>\n<p>Рекомендация: здесь можно потренироваться искать баги, а потом описывать их в баг-трекере, например в бесплатной версии Jira.</p>\n<p>&nbsp;</p>\n<p>&nbsp;</p></div>\n\n</div></div>            \n        \n        \n    </div></div>\n\n            \n        \n    \n</div>\n</div>\n                                </div>\n                \n            \n        \n    \n</div>\n<style>#page\\#0-0-0 { min-height: 590px; } </style>\n\n            \n            \n\n            <!-- Builder #footer -->\n<div class=\"uk-section-secondary uk-section uk-section-large uk-padding-remove-bottom\" uk-scrollspy=\"target: [uk-scrollspy-class]; cls: uk-animation-slide-left-small; delay: false;\">\n    \n        \n        \n        \n            \n                                <div class=\"uk-container uk-container-xlarge\">                \n                    \n                    <div class=\"uk-grid-margin\" uk-grid>\n<div class=\"uk-flex-auto uk-width-1-4@m uk-width-1-2@s\">\n    \n        \n            \n            \n                \n<h3 class=\"uk-h4\" uk-scrollspy-class>        Подпишитесь на рассылку лучших фотографий    </h3>\n<div class=\"uk-width-large@s uk-margin-auto-right\" uk-scrollspy-class>\n    <form class=\"uk-form uk-panel js-form-newsletter\" method=\"post\" action=\"/index.php?p=theme%2Fnewsletter%2Fsubscribe&amp;option=com_ajax&amp;style=9\">\n\n        <div class=\"uk-child-width-expand@s\" uk-grid>\n            \n            \n                        <div class=\"uk-position-relative\">\n                <button class=\"el-button uk-form-icon uk-form-icon-flip\" uk-icon=\"icon: mail;\" title=\"Subscribe\"></button>                <input class=\"el-input uk-input\" type=\"email\" name=\"email\" placeholder=\"Email address\" required>            </div>\n            \n        </div>\n\n        <input type=\"hidden\" name=\"settings\" value=\"HiAL1AS6VYQfb/1MrOlTxQ==..Y2U5M2Y0ZjM0ZDQwNjUzMzFhZmI2YjAyYjIyMjRjZDZmN2M4MTFhN2JjMWJjYTljZGEwMjM1ZGI5NDQ1NjE5Yw==\">\n        <div class=\"message uk-margin uk-hidden\"></div>\n\n    </form>\n\n</div